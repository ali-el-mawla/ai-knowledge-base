# ---------------------------------------------------------------------------
# AI Knowledge Base configuration. `npm run setup` copies this file to `.env`
# and fills the Supabase values for you. One file serves the web app and the API.
# Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Supabase (local stack from `supabase start`) ----------------------------
# Filled automatically by `npm run setup` from `supabase status`.
# Use 127.0.0.1, not localhost: tokens are issued for this exact host.
SUPABASE_URL=http://127.0.0.1:54321
# Publishable key: safe in the browser, every request still passes RLS.
SUPABASE_PUBLISHABLE_KEY=
# Secret key: API only (ingestion worker, seed and reembed CLIs). Bypasses RLS.
SUPABASE_SECRET_KEY=

# The browser needs its own copies (Next.js only exposes NEXT_PUBLIC_* vars).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- API -------------------------------------------------------------------
API_PORT=4000
# Origin allowed by CORS (the web app).
WEB_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000/api

# --- Chat model (any OpenAI-compatible provider) ------------------------------
# CHAT_PROVIDER: anthropic | openai | groq | together | openrouter | ollama | custom
# Leave CHAT_PROVIDER empty to run without chat (documents and search still work).
# See the README section "Swapping AI providers" for a tested example of each.
CHAT_PROVIDER=anthropic
CHAT_MODEL=claude-haiku-4-5
CHAT_API_KEY=
# Optional: override the preset's base URL (required when CHAT_PROVIDER=custom).
CHAT_BASE_URL=
# Optional: a smaller model for rewriting follow-up questions (defaults to CHAT_MODEL).
REWRITE_MODEL=

# --- Embedding model ---------------------------------------------------------
# EMBEDDING_PROVIDER: ollama | openai | together | custom
# The database column is vector(768). Supported out of the box:
#   ollama  + nomic-embed-text        (768 native, local, free)   <- default
#   openai  + text-embedding-3-small  (with EMBEDDING_DIMENSIONS=768)
# Changing the embedding model or dimensions? Run `npm run reembed` afterwards.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
EMBEDDING_API_KEY=
# Optional: override the preset's base URL (required when EMBEDDING_PROVIDER=custom).
EMBEDDING_BASE_URL=
# nomic-embed-text is trained with task prefixes and needs them. Keep the trailing
# space. For OpenAI embeddings, set both to empty.
EMBEDDING_DOCUMENT_PREFIX="search_document: "
EMBEDDING_QUERY_PREFIX="search_query: "

{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS API: documents, ingestion, hybrid retrieval and the streaming RAG chat.",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "seed": "node dist/cli/seed.js",
    "reembed": "node dist/cli/reembed.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@repo/shared": "*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.7",
    "@nestjs/schematics": "^12.0.5",
    "@nestjs/testing": "^12.1.0",
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "eslint": "^9.39.5",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.2"
  }
}
